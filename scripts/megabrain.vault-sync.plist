<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>megabrain.vault-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- UPDATE: replace with actual path to mac-sync.sh -->
    <string>/path/to/megabrain/scripts/mac-sync.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VAULT_PATH</key>
    <!-- UPDATE: replace with your Obsidian vault path -->
    <string>/path/to/your/ObsidianVault</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/megabrain-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/megabrain-sync.log</string>
</dict>
</plist>
