# Neon PostgreSQL — get from https://console.neon.tech
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/megabrain?sslmode=require

# OpenAI (embeddings) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub — fine-grained token with Contents read/write on your shared vault repo
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_...

# Your shared team vault repo (e.g. your-org/company-vault)
GITHUB_REPO=your-org/company-vault

# Webhook secret — generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Per-user API keys: "name:key,name:key,..." — one entry per teammate.
# Generate each with: npx tsx src/cli.ts gen-key <name>
# Writes are attributed to the matching name (e.g. "[bob] Add note: ...").
API_KEYS=andrea:key1,bob:key2

# Server port (default 3000)
PORT=3000

# Public URL of this server — used in the OpenAPI spec for Custom GPTs
PUBLIC_URL=https://your-app.railway.app
