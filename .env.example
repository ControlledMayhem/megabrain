# Neon PostgreSQL — get from https://console.neon.tech
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/megabrain?sslmode=require

# OpenAI (embeddings) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub — fine-grained token with Contents read/write on your vault repo
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_...

# Your private vault repo (e.g. your-username/your-vault-repo)
GITHUB_REPO=your-username/your-vault-repo

# Webhook secret — generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# API key for MCP/REST auth — generate with: openssl rand -hex 32
API_KEY=your-api-key

# Server port (default 3000)
PORT=3000

# Public URL of this server — used in the OpenAPI spec for Custom GPTs
PUBLIC_URL=https://your-app.railway.app
