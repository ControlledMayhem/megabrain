# ─── Required ──────────────────────────────────────────────────────
# Postgres + pgvector connection string. Works with any Postgres that has
# the pgvector extension: Neon, Supabase, or a self-hosted instance.
# (Var name kept as NEON_DATABASE_URL for backwards compatibility.)
NEON_DATABASE_URL=postgresql://user:pass@host:5432/megabrain?sslmode=require

# OpenAI (embeddings) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Vault source — how MegaBrain reads your Markdown ──────────────
# "local"  (default) — a folder of Markdown on disk. No git required.
# "github"           — a GitHub repo (opt-in; see optional section below).
VAULT_SOURCE=local

# Local driver: absolute path to your Markdown vault folder.
# Keep it current however you like (Syncthing, rsync, Gitea, GitHub…).
# Defaults to ./vault if unset.
MEGABRAIN_VAULT_PATH=/path/to/your/ObsidianVault

# ─── Optional: API auth & server ───────────────────────────────────
# API key for MCP/REST auth — generate with: openssl rand -hex 32
# (If unset, auth is disabled — fine for localhost, not for a public server.)
API_KEY=your-api-key

# Server port (default 3000)
PORT=3000

# Public URL of this server — used in the OpenAPI spec for Custom GPTs
PUBLIC_URL=https://your-app.example.com

# ─── Optional: GitHub driver (only if VAULT_SOURCE=github) ─────────
# These are REQUIRED only when VAULT_SOURCE=github, and ignored otherwise.
#
# Fine-grained token with Contents read/write on your vault repo.
# Create at: https://github.com/settings/tokens?type=beta
# GITHUB_TOKEN=github_pat_...
#
# Your vault repo, "owner/repo"
# GITHUB_REPO=your-username/your-vault-repo
#
# Webhook secret for push-driven incremental sync — openssl rand -hex 20
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
